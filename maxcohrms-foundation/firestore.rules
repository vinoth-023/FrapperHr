rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Membership documents are provisioned by trusted server-side code.
    function activeMember(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Default-deny. Sensitive writes go through validated server APIs.
    match /{document=**} {
      allow read, write: if false;
    }

    // Optional client reads can be enabled collection-by-collection after
    // reviewing data sensitivity and query constraints. Never allow broad
    // employee/payroll reads based only on sign-in.
  }
}
