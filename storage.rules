rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default-deny everything to prevent cross-app contamination on shared buckets
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // HRMS dedicated prefix maxco-hr/
    match /maxco-hr/{companyId}/{allPaths=**} {
      // Must be authenticated to access any HRMS asset
      allow read: if request.auth != null;
      // Writes restricted to authenticated company operations (e.g. docs, photos)
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
