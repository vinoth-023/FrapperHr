# Client-side Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maxco-certificate-generator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maxco-certificate-generator.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_ID=maxco-hr
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maxco-certificate-generator.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_PREFIX=maxco-hr/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Server-Side Firebase Admin (Private keys only on server, never client-side)
FIREBASE_ADMIN_PROJECT_ID=maxco-certificate-generator
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
